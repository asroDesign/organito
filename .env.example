# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Set to true behind HTTPS
COOKIE_SECURE=false
# SMS providers (optional; without keys SMS is simulated and logged)
KAVENEGAR_API_KEY=
SMSIR_API_KEY=

# Zarinpal payment gateway (https://www.zarinpal.com). Without a merchant id a local simulator is used.
ZARINPAL_MERCHANT_ID=
# "true" → sandbox.zarinpal.com
ZARINPAL_SANDBOX=false
# Zibal merchant id. When empty, Zibal's public sandbox merchant ("zibal") is used.
ZIBAL_MERCHANT=2e503fef-45de-4c60-82ee-de9bbb47cc2f
# Public base URL used for the gateway callback (e.g. https://yadaktak.ir). Auto-detected if empty.
APP_URL=

# Admin ZIP updates are restricted to signed Ed25519 packages and self-hosted PM2 production.
# Keep the signing private key off the server and outside the repository.
UPDATE_PUBLIC_KEY_PEM=
UPDATE_APPLY_ENABLED=false
UPDATE_PM2_APP=organito-app
UPDATE_HEALTHCHECK_URL=http://127.0.0.1:6008/api/health
